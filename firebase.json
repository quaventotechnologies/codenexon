{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/privacy-policy.html",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/terms.html",
        "destination": "/terms-and-conditions",
        "type": 301
      },
      {
        "source": "/affiliate-disclosure.html",
        "destination": "/disclosure",
        "type": 301
      },
      {
        "source": "/author-shubham-handore.html",
        "destination": "/author/shubham-handore",
        "type": 301
      },
      {
        "source": "/categories.html",
        "destination": "/guides",
        "type": 301
      },
      {
        "source": "/sitemap.html",
        "destination": "/guides",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/blog-image/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/llms*.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
